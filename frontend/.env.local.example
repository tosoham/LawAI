# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1

# Application Settings
NEXT_PUBLIC_APP_NAME=LawAI
NEXT_PUBLIC_APP_DESCRIPTION=Multi-agent Indian legal AI system

# Feature Flags
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_DOCUMENT_GENERATION=true
NEXT_PUBLIC_ENABLE_DOCUMENT_ANALYSIS=true

# File Upload Settings
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_ALLOWED_FILE_TYPES=pdf,docx

# Legal Disclaimer
NEXT_PUBLIC_SHOW_DISCLAIMER=true