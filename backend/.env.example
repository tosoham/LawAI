# AIML API Configuration (REQUIRED - get a key at https://aimlapi.com)
AIML_API_KEY=your_aimlapi_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1

# Model Configuration
AIML_MODEL=gpt-4o-mini
AIML_MAX_TOKENS=2048
AIML_TEMPERATURE=0.7

# Live Judiciary Access
# Fetches current case law from authentic public sources at query time, covering
# judgements handed down after the local corpus was built. Set to false for
# fully offline operation.
ENABLE_LIVE_JUDICIARY=true
JUDICIARY_TIMEOUT_SECONDS=20
JUDICIARY_MIN_REQUEST_INTERVAL=2.5
# The interval widens on a 429 and is never narrowed again in the process.
# At 1.0s a discovery run drew 429 on 21 of 36 searches; at 2.5s with backoff,
# none failed and 332 candidates came back instead of 133.
JUDICIARY_MAX_REQUEST_INTERVAL=30.0
JUDICIARY_BACKOFF_FACTOR=2.0
JUDICIARY_MAX_RETRIES=3
JUDICIARY_SEARCH_CACHE_TTL=900
JUDICIARY_DOC_CACHE_TTL=86400

# ChromaDB Configuration
CHROMADB_PATH=./chroma_db

# Retrieval reranking
# A cross-encoder reorders the candidates the vector store returns. Measured
# against eval/concordance.json: recall@3 +0.043 overall, recall@1 0.812 ->
# 0.870, no class regressed. Set false to measure without it, or where the
# model cannot be fetched -- it fails soft to bi-encoder ranking either way.
ENABLE_RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Candidates pulled from the store before reordering. A reranker can only move
# an answer within this pool, never add one.
RERANK_CANDIDATES=20

# Hybrid retrieval
# A BM25 ranking is fused into the dense candidates by reciprocal rank fusion.
# The two retrievers fail on disjoint sets: BM25 alone beats dense at recall@3
# on citation (0.875 vs 0.250) and judgement (1.000 vs 0.833), and is beaten on
# term_of_art (0.250 vs 0.875). Fused, recall@3 is 1.000 on all 69 golden
# queries. Set false for dense-only retrieval.
ENABLE_HYBRID=true
HYBRID_CANDIDATES=30

# Multi-agent orchestration
# How many corpus queries one specialist may make for one plan step. The loop
# is "retrieve, notice a gap, fill it", which is two; the third is slack.
SPECIALIST_MAX_RETRIEVALS=3
# Conversation memory. Off by default: the available checkpointer keeps threads
# in process memory, so it grows without bound and is invisible to a second
# worker. Turning it on is a decision about where state lives.
ENABLE_CONVERSATION_MEMORY=false
# Pause for confirmation before writing a document. Requires the above --
# interrupt records where it stopped in a checkpoint, so with no checkpointer
# the pause loses the turn rather than holding it.
ENABLE_DRAFT_CONFIRMATION=false

# Production feedback capture
# Records answers that tripped a self-labelling signal -- the system abstained,
# the verifier removed claims, or retrieval returned nothing -- so they can be
# reviewed and become golden-set entries. Off by default: it writes user-typed
# text to disk, which is a data-handling decision rather than a default.
# Read the queue with scripts/review_feedback.py.
ENABLE_FEEDBACK_CAPTURE=false
FEEDBACK_LOG_PATH=./feedback/events.jsonl
FEEDBACK_MAX_QUERY_CHARS=500

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100
API_RATE_LIMIT_PERIOD=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Application Settings
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx

# Development
DEBUG=True
RELOAD=True
