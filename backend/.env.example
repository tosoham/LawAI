# AIML API Configuration (REQUIRED - get a key at https://aimlapi.com)
AIML_API_KEY=your_aimlapi_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1

# Model Configuration
AIML_MODEL=gpt-4o-mini
AIML_MAX_TOKENS=2048
AIML_TEMPERATURE=0.7

# Live Judiciary Access
# Fetches current case law from authentic public sources at query time, covering
# judgements handed down after the local corpus was built. Set to false for
# fully offline operation.
ENABLE_LIVE_JUDICIARY=true
JUDICIARY_TIMEOUT_SECONDS=20
JUDICIARY_MIN_REQUEST_INTERVAL=1.0
JUDICIARY_SEARCH_CACHE_TTL=900
JUDICIARY_DOC_CACHE_TTL=86400

# ChromaDB Configuration
CHROMADB_PATH=./chroma_db

# Retrieval reranking
# A cross-encoder reorders the candidates the vector store returns. Measured
# against eval/concordance.json: recall@3 +0.043 overall, recall@1 0.812 ->
# 0.870, no class regressed. Set false to measure without it, or where the
# model cannot be fetched -- it fails soft to bi-encoder ranking either way.
ENABLE_RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Candidates pulled from the store before reordering. A reranker can only move
# an answer within this pool, never add one.
RERANK_CANDIDATES=20

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100
API_RATE_LIMIT_PERIOD=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Application Settings
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx

# Development
DEBUG=True
RELOAD=True
